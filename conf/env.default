;change these variable names if more than one instance of OASYS is installed

[database]
host = db_oasys_host
db = db_oasys_name
user = db_oasys_user
password = db_oasys_pass

[crypt]
aes_key = oasys_aes_key
aes_iv = oasys_aes_iv
; Used temporarily by the System Settings key-rotation workflow.
aes_pending_key = oasys_aes_pending_key
aes_pending_iv = oasys_aes_pending_iv
