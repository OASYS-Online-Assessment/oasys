; Service provider [SP] variables -- data to be submitted to IdP
[sp]
ACS = ""
Issuer = ""

; Identity provider [IdP] variables -- data to be consumed by SP (Oasys)
[idp]
SSOLoginURL = "https://"
SSOLogoutURL = "https://"
IDPhost = "https://"
IDPIssuerId = ""
IDPuidStr = "urn:oid:0.9.2342.19200300.100.1.1"
; Optional trust store for IdP certificate chain validation.
; Set either IDPTrustedCertFile to a PEM bundle or IDPTrustedCertDir to a directory of PEM/CRT/CER files.
; When both are empty, PHP/OpenSSL will fall back to its system CA store.
IDPTrustedCertFile = ""
IDPTrustedCertDir = ""