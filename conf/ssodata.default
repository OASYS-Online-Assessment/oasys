; Service provider [SP] variables -- data to be submitted to IdP
[sp]
ACS = ""
Issuer = ""

; Identity provider [IdP] variables -- data to be consumed by SP (Oasys)
[idp]
SSOLoginURL = "https://"
SSOLogoutURL = "https://"
IDPhost = "https://"
IDPIssuerId = ""
IDPuidStr = "urn:oid:0.9.2342.19200300.100.1.1"
sigAlgo = OPENSSL_ALGO_SHA1

; POSSIBLE SIGNATURE ALGORITHM CONSTANTS:  
; ---------------------------------------
; OPENSSL_ALGO_DSS1  
; OPENSSL_ALGO_SHA1 (default for openssl_verify() function)  
; OPENSSL_ALGO_SHA224  
; OPENSSL_ALGO_SHA256  
; OPENSSL_ALGO_SHA384  
; OPENSSL_ALGO_SHA512  
; OPENSSL_ALGO_RMD160  
; OPENSSL_ALGO_MD5  
; OPENSSL_ALGO_MD4  
; OPENSSL_ALGO_MD2 (if Php compiled with MD2 support)
